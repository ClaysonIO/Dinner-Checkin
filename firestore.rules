rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only installs of the app (which sign in anonymously) can read or write.
    match /days/{date} {
      allow read, write: if request.auth != null;
    }
    match /config/household {
      allow read, write: if request.auth != null;
    }
  }
}
